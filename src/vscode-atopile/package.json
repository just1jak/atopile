{
  "name": "atopile-local",
  "displayName": "Atopile Local",
  "description": "Local circuit design with ChatGPT, KiCad schematics, and PCB inspection.",
  "version": "0.3.0",
  "publisher": "local-atopile",
  "repository": {
    "type": "git",
    "url": "https://github.com/just1jak/atopile.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "ato_logo_256x256.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atopileLocal-sidebar",
          "title": "Atopile Local",
          "icon": "resources/atopile-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "atopileLocal-agent",
          "title": "Agent",
          "icon": "resources/atopile-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "atopileLocal-logs",
          "title": "Build",
          "icon": "resources/atopile-icon.svg"
        }
      ]
    },
    "views": {
      "atopileLocal-sidebar": [
        {
          "type": "webview",
          "id": "atopileLocal.sidebarView",
          "name": ""
        }
      ],
      "atopileLocal-logs": [
        {
          "type": "webview",
          "id": "atopileLocal.logsView",
          "name": "Build"
        }
      ],
      "atopileLocal-agent": [
        {
          "type": "webview",
          "id": "atopileLocal.agentView",
          "name": "Agent",
          "visibility": "visible",
          "order": 0
        }
      ]
    },
    "languages": [
      {
        "id": "ato",
        "aliases": [
          "atopile",
          "ato"
        ],
        "extensions": [
          ".ato"
        ],
        "icon": {
          "dark": "./ato_logo_256x256.png",
          "light": "./ato_logo_256x256.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ato",
        "scopeName": "source.ato",
        "path": "./syntaxes/ato.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Atopile Local",
      "properties": {
        "atopileLocal.ato": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Full path to the Atopile Local compiler launcher. Supports ${workspaceFolder} and ${workspaceRoot}. Run the supplied setup script first."
        },
        "atopileLocal.enableChat": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Show the AI chat dock in the atopile sidebar."
        },
        "atopileLocal.agent.provider": {
          "type": "string",
          "enum": [
            "codex",
            "openai",
            "anthropic"
          ],
          "default": "codex",
          "scope": "machine",
          "description": "Your AI provider. ChatGPT (Codex) uses your Codex sign-in; API providers use separate credentials.",
          "enumDescriptions": [
            "ChatGPT (Codex): reuse your native Codex ChatGPT sign-in.",
            "OpenAI-compatible API endpoint using an API key.",
            "Anthropic API using an API key."
          ]
        },
        "atopileLocal.agent.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional API endpoint for OpenAI/Anthropic. Ignored for ChatGPT (Codex). Local OpenAI-compatible servers must implement the Responses API with streaming and tool calls."
        },
        "atopileLocal.agent.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional model ID. Empty uses the native Codex default for ChatGPT, gpt-5.4 for OpenAI, or claude-sonnet-4-6 for Anthropic."
        },
        "atopileLocal.agent.codexPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Codex executable path. Empty searches PATH and installed macOS ChatGPT/Codex apps. Used for native ChatGPT login and inference."
        }
      }
    },
    "commands": [
      {
        "command": "atopileLocal.openPanel",
        "title": "Atopile Local: Open Panel"
      },
      {
        "command": "atopileLocal.startBuild",
        "title": "Atopile Local: Start Build"
      },
      {
        "command": "atopileLocal.demo-mode",
        "title": "Demo Mode",
        "category": "Atopile Local"
      },
      {
        "command": "atopileLocal.setApiKey",
        "title": "Atopile Local: Set AI API Key"
      },
      {
        "command": "atopileLocal.clearApiKey",
        "title": "Atopile Local: Clear AI API Key"
      },
      {
        "command": "atopileLocal.openAgentSettings",
        "title": "Atopile Local: Configure AI Provider"
      },
      {
        "command": "atopileLocal.openKicad",
        "title": "Atopile Local: Open KiCad PCB Editor"
      },
      {
        "command": "atopileLocal.openFile",
        "title": "Atopile Local: Open File"
      },
      {
        "command": "atopileLocal.connectChatGPT",
        "title": "Atopile Local: Connect ChatGPT"
      }
    ],
    "themes": [
      {
        "label": "Atopile Local Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/atopile-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "generate:types": "bun run scripts/generate-types.ts",
    "build": "bun run generate:types && cd ../.. && bun build src/vscode-atopile/src/extension.ts --outfile src/vscode-atopile/dist/extension.js --target node --format cjs --external vscode --minify && cd src/ui/webview && bun run build",
    "watch": "bun run generate:types && concurrently \"cd ../.. && bun build src/vscode-atopile/src/extension.ts --outfile src/vscode-atopile/dist/extension.js --target node --format cjs --external vscode --watch\" \"cd ../ui/webview && bun run watch\"",
    "package": "bun run build && vsce package --allow-missing-repository --no-dependencies"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "js-yaml": "^4.1.1",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.2",
    "@types/vscode": "1.105.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.7.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
  },
  "license": "MIT",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension starts a local compiler and AI tools that can edit the trusted project."
    },
    "virtualWorkspaces": false
  }
}
